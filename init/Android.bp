cc_library_static {
    name: "libinit_sm6150",
    recovery_available: true,
    srcs: ["init_sm6150.cpp"],
    include_dirs: [
        "system/core/init",
        "system/libbase/include"
    ],
    shared_libs: [
        "libbase",
    ]
}
